# Production environment for deploy/docker-compose.yml. Lives at /opt/signalyze/.env
# deploy.sh creates it from this template on first run and generates POSTGRES_PASSWORD.

POSTGRES_PASSWORD=
# Comma-separated extension ids allowed by CORS (dev id + Web Store id).
EXTENSION_IDS=mecknkahfceojapfdeaelbapigaijcek
# Loopback port on the host for smoke tests. deploy.sh bumps to 8091 if 8090 is taken.
API_HOST_PORT=8090
# Optional Phase 3 LLM endpoint (OpenAI-compatible). Empty = disabled.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
