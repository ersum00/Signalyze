---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="There is no page at this address.">
  <main id="main" class="mx-auto max-w-3xl px-5 py-24 text-center sm:px-8 sm:py-32">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Nothing at this address.</h1>
    <p class="mt-4 text-ink-600">
      The page may have moved. Everything on this site is reachable from the home page.
    </p>
    <a href="/" class="btn-primary mt-8">Go to the home page</a>
  </main>
</Base>
