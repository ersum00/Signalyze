---
import {
  BURST_WINDOW_DAYS,
  CACHE_TTL_DAYS,
  DEFAULT_REVIEW_LIMIT,
  EXTENDED_REVIEW_LIMIT,
  MIN_REVIEWS_FOR_SCORE,
  NGRAM_SIZE,
} from '@signalyze/shared';
import SidePanelMock from '../components/SidePanelMock.astro';
import Base from '../layouts/Base.astro';
import { SIGNALS } from '../lib/signals';
import { STORE_URL, SUMMARY_SENTENCE } from '../lib/site';

const readouts = [
  { value: '62%', text: `of reviews were posted within one ${BURST_WINDOW_DAYS}-day window` },
  { value: '71%', text: 'of reviewers have no other review' },
  { value: '0.31', text: `mean character ${NGRAM_SIZE}-gram overlap between review texts` },
];

const steps = [
  {
    title: 'Open a business on Google Maps',
    text: `Any place page with at least ${MIN_REVIEWS_FOR_SCORE} reviews. Signalyze stays idle until you ask for it.`,
  },
  {
    title: 'Click Analyze',
    text: `The extension scrolls the review panel Google has already rendered and reads up to ${DEFAULT_REVIEW_LIMIT} reviews, or ${EXTENDED_REVIEW_LIMIT} with "Load more". It never opens another page.`,
  },
  {
    title: 'Read the Review Profile',
    text: 'The side panel shows the score, the ten signals, reviews per month, the rating distribution and a reviewer summary, each explained in plain language.',
  },
];

const views = [
  {
    title: 'Score and ten signals',
    text: 'A 0 to 100 Signalyze Score, and under it every signal with its value. Each one has a plain-language explanation and a link to its formula.',
  },
  {
    title: 'Reviews per month',
    text: 'How many reviews arrived each month, so a burst is visible at a glance.',
  },
  {
    title: 'Rating distribution',
    text: 'How the stars are spread from 5 to 1. A shape concentrated at both ends looks different from a smooth one.',
  },
  {
    title: 'Reviewer profile',
    text: 'How many reviewers have only this review, how many are established Local Guides, and how many posted no photo and little text.',
  },
];

const sends = [
  'The place identifier from the page URL, used as a cache key.',
  'Per review: star rating, calendar day (no time of day), text, the reviewer’s public review count, photo count, Local Guide level if shown, and the owner response if any.',
  'Per review: a one-way hash of the reviewer id, the place id and a daily salt made in your browser, so distinct reviewers can be counted without knowing who they are.',
  'The displayed total review count and overall rating.',
  'Interface language and extension version.',
];

const neverSends = [
  'Reviewer names, profile URLs, avatars, user ids or any other reviewer identifier.',
  'Your Google account, your name or your email address.',
  'Your browsing history, other tabs, cookies or local storage.',
  'Your location. The API sees the request’s IP address as every web server does; it is used in memory for rate limiting and never stored.',
];

const notes = [
  'No letter grade and no pass or fail. A number from 0 to 100, always shown with the sentence above.',
  'Every signal is listed separately with its formula on the methodology page, so you can disagree with the weighting.',
  `Fewer than ${MIN_REVIEWS_FOR_SCORE} reviews: no score at all, only "insufficient data". Small samples produce extreme ratios.`,
  'No per-review labels, no flags, no reporting features and no comparisons between named businesses.',
];

const faq = [
  {
    q: 'Is it free?',
    a: 'Yes. Signalyze is free, with no premium tier and no ads.',
  },
  {
    q: 'Does it need an account?',
    a: 'No. There are no accounts, no cookies, no analytics and no telemetry. The only thing the extension keeps is your settings and a local cache of profiles you have viewed, in your own browser.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. If the Signalyze API cannot be reached, or if you decline data sending, the same signal engine runs inside your browser. Those results are labelled "offline analysis" so you know they did not come from the shared cache.',
  },
  {
    q: 'Does it work on sites other than Google Maps?',
    a: 'Not yet. Version 0.1 works on Google Maps business pages. Support for the Google Search knowledge panel is planned for Phase 2.',
  },
  {
    q: 'How is the score computed?',
    a: `Each signal is a number between 0 and 1 that says how unusual the measured value is compared with typical reviewed places. The Signalyze Score is a weighted combination of the signals that could be computed, on a 0 to 100 scale. Below ${MIN_REVIEWS_FOR_SCORE} reviews no score is shown. Every formula and weight is on the <a href="/methodology" class="text-brand-600 underline underline-offset-2">methodology page</a>.`,
  },
];
---

<Base
  title="Signalyze"
  description="A free Chrome extension that shows a statistical Review Profile for any Google Maps business: ten measurable signals combined into a 0 to 100 Signalyze Score. No account, no tracking."
  home
>
  <main id="main">
    <!-- Hero -->
    <section
      class="mx-auto grid max-w-6xl gap-12 px-5 pt-16 pb-12 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:pt-24 lg:pb-20"
    >
      <div>
        <p class="eyebrow">free chrome extension · google maps</p>
        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-[3.5rem] lg:leading-[1.05]"
        >
          The statistics behind a star rating.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-600">
          Signalyze turns the reviews already on a Google Maps page into a Review Profile: ten
          measurable signals, from timing bursts to text similarity, combined into a 0 to 100
          Signalyze Score. No account, no tracking.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={STORE_URL} class="btn-primary">Add to Chrome</a>
          <a
            href="/methodology"
            class="text-sm font-medium text-ink-700 underline decoration-line underline-offset-4 hover:text-brand-600 hover:decoration-brand-500"
            >Read the methodology</a
          >
        </div>
        <p class="mt-3 text-sm text-ink-400">Chrome Web Store listing coming soon.</p>
      </div>

      <aside
        aria-label="Example signal readouts"
        class="rounded-2xl border border-line bg-paper p-6 sm:p-8"
      >
        <p class="eyebrow text-ink-400">what a signal looks like</p>
        <ul class="mt-4 divide-y divide-line">
          {
            readouts.map((r) => (
              <li class="grid grid-cols-[6rem_1fr] items-baseline gap-4 py-4">
                <span class="font-mono text-3xl font-semibold tracking-tight tabular-nums sm:text-4xl">
                  {r.value}
                </span>
                <span class="text-sm text-ink-600">{r.text}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-ink-400">
          Statements about the distribution of public data. Anyone can recompute them from the same
          page.
        </p>
      </aside>
    </section>

    <!-- How it works -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="how">
      <p class="eyebrow">3 steps</p>
      <h2 id="how" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">How it works</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="rounded-xl border border-line p-6">
              <span class="font-mono text-sm text-brand-600 tabular-nums">{i + 1}</span>
              <h3 class="mt-3 font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm text-ink-600">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- What you see -->
    <section class="border-y border-line bg-paper" aria-labelledby="see">
      <div
        class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-20"
      >
        <SidePanelMock />
        <div>
          <p class="eyebrow">the side panel</p>
          <h2 id="see" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
            What you see
          </h2>
          <dl class="mt-8 divide-y divide-line">
            {
              views.map((v) => (
                <div class="py-5">
                  <dt class="font-semibold">{v.title}</dt>
                  <dd class="mt-1 text-sm text-ink-600">{v.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- The ten signals -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="signals">
      <p class="eyebrow">10 signals · engine 1.0.0</p>
      <h2 id="signals" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        The ten signals
      </h2>
      <p class="mt-4 max-w-2xl text-ink-600">
        Each signal is a value between 0 and 1 that expresses how unusual the measured quantity is
        compared with typical reviewed places. Nothing is inferred about intent; every one is a fact
        about the distribution of public data.
      </p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          SIGNALS.map((s) => (
            <li class="rounded-xl border border-line p-5">
              <p class="font-mono text-[11px] text-brand-600">{s.id}</p>
              <h3 class="mt-2 font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm text-ink-600">{s.description}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-ink-600">
        Formulas, weights and thresholds: <a
          href="/methodology"
          class="font-medium text-brand-600 underline underline-offset-2">methodology</a
        >.
      </p>
    </section>

    <!-- Data -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="data">
      <p class="eyebrow">from docs/PRIVACY.md</p>
      <h2 id="data" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        What it sends and what it never sends
      </h2>
      <p class="mt-4 max-w-2xl text-ink-600">
        Nothing leaves your browser until you click Analyze, and only after you have accepted the
        one-time consent screen. Decline it and every analysis runs locally.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-line p-6">
          <h3 class="font-semibold">Sent, once per analysis</h3>
          <ul class="mt-4 space-y-3 text-sm text-ink-600">
            {
              sends.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-xl border border-line p-6">
          <h3 class="font-semibold">Never sent</h3>
          <ul class="mt-4 space-y-3 text-sm text-ink-600">
            {
              neverSends.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-400" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <dl class="mt-6 grid gap-6 text-sm sm:grid-cols-3">
        <div>
          <dt class="font-semibold">Kept on the server</dt>
          <dd class="mt-1 text-ink-600">
            The computed profile per place, for {CACHE_TTL_DAYS} days. Two daily counters with no identifiers.
          </dd>
        </div>
        <div>
          <dt class="font-semibold">Never stored</dt>
          <dd class="mt-1 text-ink-600">Review text, reviewer hashes and IP addresses.</dd>
        </div>
        <div>
          <dt class="font-semibold">Never contacted</dt>
          <dd class="mt-1 text-ink-600">
            Google. The API makes no request to any Google service, enforced by a test and a runtime
            guard.
          </dd>
        </div>
      </dl>
      <p class="mt-6 text-sm text-ink-600">
        Full details, field by field: <a
          href="/privacy"
          class="font-medium text-brand-600 underline underline-offset-2">privacy</a
        >.
      </p>
    </section>

    <!-- Not a verdict -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="verdict">
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6 sm:p-10">
        <p class="eyebrow">shown under every score</p>
        <h2 id="verdict" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
          It is not a verdict
        </h2>
        <blockquote
          class="mt-6 max-w-3xl border-l-2 border-brand-500 pl-5 text-xl font-medium text-balance text-ink-900 sm:text-2xl"
        >
          {SUMMARY_SENTENCE}
        </blockquote>
        <ul class="mt-8 grid gap-4 text-sm text-ink-700 sm:grid-cols-2">
          {notes.map((n) => <li class="rounded-lg bg-white/70 px-4 py-3">{n}</li>)}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="faq">
      <p class="eyebrow">5 questions</p>
      <h2 id="faq" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        Frequently asked
      </h2>
      <div class="mt-8 border-t border-line">
        {
          faq.map((item) => (
            <details class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium [&::-webkit-details-marker]:hidden">
                {item.q}
                <span
                  class="text-xl leading-none text-ink-400 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="pb-5 text-sm text-ink-600" set:html={item.a} />
            </details>
          ))
        }
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="mx-auto max-w-6xl px-5 pb-8 sm:px-8">
      <div
        class="flex flex-col items-start gap-6 rounded-2xl border border-line p-6 sm:flex-row sm:items-center sm:justify-between sm:p-10"
      >
        <div>
          <h2 class="text-xl font-semibold tracking-tight">Read the profile, then decide.</h2>
          <p class="mt-1 text-sm text-ink-600">
            Free, no account, nothing sent until you click Analyze.
          </p>
        </div>
        <div class="shrink-0">
          <a href={STORE_URL} class="btn-primary">Add to Chrome</a>
          <p class="mt-2 text-xs text-ink-400">Store listing coming soon.</p>
        </div>
      </div>
    </section>
  </main>
</Base>
