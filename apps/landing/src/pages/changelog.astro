---
import { getEntry, render } from 'astro:content';
import Doc from '../layouts/Doc.astro';

const entry = await getEntry('changelog', 'changelog');
if (!entry) throw new Error('CHANGELOG.md was not found by the content loader.');
const { Content } = await render(entry);
---

<Doc
  title="Changelog"
  description="Release notes for the Signalyze extension, API and site."
  source="CHANGELOG.md"
>
  <Content />
</Doc>
