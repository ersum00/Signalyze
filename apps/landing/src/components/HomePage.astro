---
import {
  BURST_WINDOW_DAYS,
  CACHE_TTL_DAYS,
  ALL_REVIEWS_CEILING,
  DEFAULT_REVIEW_LIMIT,
  MIN_REVIEWS_FOR_SCORE,
  NGRAM_SIZE,
} from '@signalyze/shared';
import { localePath, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { getScreenshots } from '../lib/screenshots';
import { getSignals } from '../lib/signals';
import { STORE_URL } from '../lib/site';
import SidePanelMock from './SidePanelMock.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const signals = getSignals(locale);
const screenshots = getScreenshots(locale);
const methodologyUrl = localePath(locale, '/methodology');
const privacyUrl = localePath(locale, '/privacy');

/** Inline links inside translated sentences get the site's link styling. */
const LINK_CLASS = 'font-medium text-brand-600 underline underline-offset-2';
const withLinkStyle = (html: string) =>
  html.replaceAll('<a href=', `<a class="${LINK_CLASS}" href=`);

const readouts = [
  { value: '62%', text: t('hero.readouts.burst', { days: BURST_WINDOW_DAYS }) },
  { value: '71%', text: t('hero.readouts.single') },
  { value: '0.31', text: t('hero.readouts.overlap', { n: NGRAM_SIZE }) },
];

const steps = [
  { title: t('how.step1.title'), text: t('how.step1.text', { min: MIN_REVIEWS_FOR_SCORE }) },
  {
    title: t('how.step2.title'),
    text: t('how.step2.text', { limit: DEFAULT_REVIEW_LIMIT, ceiling: ALL_REVIEWS_CEILING }),
  },
  { title: t('how.step3.title'), text: t('how.step3.text') },
];

const views = [
  { title: t('see.score.title'), text: t('see.score.text') },
  { title: t('see.monthly.title'), text: t('see.monthly.text') },
  { title: t('see.rating.title'), text: t('see.rating.text') },
  { title: t('see.reviewers.title'), text: t('see.reviewers.text') },
];

const sends = [
  t('data.sent.1'),
  t('data.sent.2'),
  t('data.sent.3'),
  t('data.sent.4'),
  t('data.sent.5'),
];
const neverSends = [t('data.never.1'), t('data.never.2'), t('data.never.3'), t('data.never.4')];

const notes = [
  t('verdict.note1'),
  t('verdict.note2'),
  t('verdict.note3', { min: MIN_REVIEWS_FOR_SCORE }),
  t('verdict.note4'),
];

const faq = [
  { q: t('faq.1.q'), a: t('faq.1.a') },
  { q: t('faq.2.q'), a: t('faq.2.a') },
  { q: t('faq.3.q'), a: t('faq.3.a') },
  { q: t('faq.4.q'), a: t('faq.4.a') },
  {
    q: t('faq.5.q'),
    a: withLinkStyle(t('faq.5.a', { min: MIN_REVIEWS_FOR_SCORE, url: methodologyUrl })),
  },
];
---

<Base locale={locale} title="Signalyze" description={t('meta.home.description')} home>
  <main id="main">
    <!-- Hero -->
    <section
      class="mx-auto grid max-w-6xl gap-12 px-5 pt-16 pb-12 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:pt-24 lg:pb-20"
    >
      <div>
        <p class="eyebrow">{t('hero.eyebrow')}</p>
        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-[3.5rem] lg:leading-[1.05]"
        >
          {t('hero.title')}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-600">{t('hero.lead')}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={STORE_URL} class="btn-primary">{t('nav.addToChrome')}</a>
          <a
            href={methodologyUrl}
            class="text-sm font-medium text-ink-700 underline decoration-line underline-offset-4 hover:text-brand-600 hover:decoration-brand-500"
            >{t('hero.methodology')}</a
          >
        </div>
      </div>

      <aside
        aria-label={t('hero.readouts.label')}
        class="rounded-2xl border border-line bg-paper p-6 sm:p-8"
      >
        <p class="eyebrow text-ink-400">{t('hero.readouts.eyebrow')}</p>
        <ul class="mt-4 divide-y divide-line">
          {
            readouts.map((r) => (
              <li class="grid grid-cols-[6rem_1fr] items-baseline gap-4 py-4">
                <span class="font-mono text-3xl font-semibold tracking-tight tabular-nums sm:text-4xl">
                  {r.value}
                </span>
                <span class="text-sm text-ink-600">{r.text}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-ink-400">{t('hero.readouts.note')}</p>
      </aside>
    </section>

    <!-- How it works -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="how">
      <p class="eyebrow">{t('how.eyebrow')}</p>
      <h2 id="how" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        {t('how.title')}
      </h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="rounded-xl border border-line p-6">
              <span class="font-mono text-sm text-brand-600 tabular-nums">{i + 1}</span>
              <h3 class="mt-3 font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm text-ink-600">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- What you see -->
    <section class="border-y border-line bg-paper" aria-labelledby="see">
      <div
        class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-20"
      >
        <SidePanelMock locale={locale} />
        <div>
          <p class="eyebrow">{t('see.eyebrow')}</p>
          <h2 id="see" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
            {t('see.title')}
          </h2>
          <dl class="mt-8 divide-y divide-line">
            {
              views.map((v) => (
                <div class="py-5">
                  <dt class="font-semibold">{v.title}</dt>
                  <dd class="mt-1 text-sm text-ink-600">{v.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- Screenshots: rendered only when public/screenshots/*.png exist at build time -->
    {
      screenshots.length > 0 && (
        <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="shots">
          <p class="eyebrow">{t('shots.eyebrow')}</p>
          <h2 id="shots" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
            {t('shots.title')}
          </h2>
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {screenshots.map((shot) => (
              <li class="overflow-hidden rounded-xl border border-line bg-paper">
                <img src={shot.src} alt={shot.alt} loading="lazy" class="block w-full" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- The ten signals -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="signals">
      <p class="eyebrow">{t('signals.eyebrow', { version: '1.0.0' })}</p>
      <h2 id="signals" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        {t('signals.title')}
      </h2>
      <p class="mt-4 max-w-2xl text-ink-600">{t('signals.lead')}</p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          signals.map((s) => (
            <li class="rounded-xl border border-line p-5">
              <p class="font-mono text-[11px] text-brand-600">{s.id}</p>
              <h3 class="mt-2 font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm text-ink-600">{s.description}</p>
            </li>
          ))
        }
      </ul>
      <p
        class="mt-6 text-sm text-ink-600"
        set:html={withLinkStyle(t('signals.more', { url: methodologyUrl }))}
      />
    </section>

    <!-- Data -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="data">
      <p class="eyebrow">{t('data.eyebrow')}</p>
      <h2 id="data" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        {t('data.title')}
      </h2>
      <p class="mt-4 max-w-2xl text-ink-600">{t('data.lead')}</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-line p-6">
          <h3 class="font-semibold">{t('data.sent.title')}</h3>
          <ul class="mt-4 space-y-3 text-sm text-ink-600">
            {
              sends.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-xl border border-line p-6">
          <h3 class="font-semibold">{t('data.never.title')}</h3>
          <ul class="mt-4 space-y-3 text-sm text-ink-600">
            {
              neverSends.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-400" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <dl class="mt-6 grid gap-6 text-sm sm:grid-cols-3">
        <div>
          <dt class="font-semibold">{t('data.kept.title')}</dt>
          <dd class="mt-1 text-ink-600">{t('data.kept.text', { days: CACHE_TTL_DAYS })}</dd>
        </div>
        <div>
          <dt class="font-semibold">{t('data.notStored.title')}</dt>
          <dd class="mt-1 text-ink-600">{t('data.notStored.text')}</dd>
        </div>
        <div>
          <dt class="font-semibold">{t('data.google.title')}</dt>
          <dd class="mt-1 text-ink-600">{t('data.google.text')}</dd>
        </div>
      </dl>
      <p
        class="mt-6 text-sm text-ink-600"
        set:html={withLinkStyle(t('data.more', { url: privacyUrl }))}
      />
    </section>

    <!-- Not a verdict -->
    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="verdict">
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6 sm:p-10">
        <p class="eyebrow">{t('verdict.eyebrow')}</p>
        <h2 id="verdict" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
          {t('verdict.title')}
        </h2>
        <blockquote
          class="mt-6 max-w-3xl border-l-2 border-brand-500 pl-5 text-xl font-medium text-balance text-ink-900 sm:text-2xl"
        >
          {t('legal.summary')}
        </blockquote>
        <ul class="mt-8 grid gap-4 text-sm text-ink-700 sm:grid-cols-2">
          {notes.map((n) => <li class="rounded-lg bg-white/70 px-4 py-3">{n}</li>)}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="faq">
      <p class="eyebrow">{t('faq.eyebrow')}</p>
      <h2 id="faq" class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        {t('faq.title')}
      </h2>
      <div class="mt-8 border-t border-line">
        {
          faq.map((item) => (
            <details class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium [&::-webkit-details-marker]:hidden">
                {item.q}
                <span
                  class="text-xl leading-none text-ink-400 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="pb-5 text-sm text-ink-600" set:html={item.a} />
            </details>
          ))
        }
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="mx-auto max-w-6xl px-5 pb-8 sm:px-8">
      <div
        class="flex flex-col items-start gap-6 rounded-2xl border border-line p-6 sm:flex-row sm:items-center sm:justify-between sm:p-10"
      >
        <div>
          <h2 class="text-xl font-semibold tracking-tight">{t('cta.title')}</h2>
          <p class="mt-1 text-sm text-ink-600">{t('cta.text')}</p>
        </div>
        <div class="shrink-0">
          <a href={STORE_URL} class="btn-primary">{t('nav.addToChrome')}</a>
        </div>
      </div>
    </section>
  </main>
</Base>
