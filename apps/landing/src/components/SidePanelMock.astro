---
/**
 * A static, illustrative rendering of the extension's side panel, built from
 * HTML and CSS only. Every number is example data.
 */
import type { SignalId } from '@signalyze/shared';
import { SIGNALS } from '../lib/signals';
import { SUMMARY_SENTENCE } from '../lib/site';

const score = 58;

const values: Record<SignalId, number> = {
  burst_ratio: 0.62,
  rating_polarity: 0.71,
  single_review_accounts: 0.71,
  no_photo_short_text: 0.44,
  text_similarity: 0.31,
  template_phrases: 0.18,
  rating_text_mismatch: 0.09,
  date_entropy: 0.53,
  local_guide_ratio: 0.18,
  owner_response_pattern: 0.35,
};

const months = [
  { label: 'S', n: 3 },
  { label: 'O', n: 4 },
  { label: 'N', n: 2 },
  { label: 'D', n: 5 },
  { label: 'J', n: 3 },
  { label: 'F', n: 4 },
  { label: 'M', n: 18 },
  { label: 'A', n: 22 },
  { label: 'M', n: 6 },
  { label: 'J', n: 4 },
  { label: 'J', n: 3 },
  { label: 'A', n: 5 },
];
const maxMonth = Math.max(...months.map((m) => m.n));

const ratings = [
  { stars: 5, pct: 64 },
  { stars: 4, pct: 9 },
  { stars: 3, pct: 4 },
  { stars: 2, pct: 3 },
  { stars: 1, pct: 20 },
];

const reviewers = [
  { value: '71%', label: 'one review only' },
  { value: '18%', label: 'Local Guide level 3+' },
  { value: '44%', label: 'no photo, short text' },
];
---

<figure class="w-full max-w-sm">
  <div class="overflow-hidden rounded-2xl border border-line bg-white text-ink-900 shadow-sm">
    <div class="flex items-center justify-between border-b border-line px-4 py-3">
      <span class="flex items-center gap-2 text-sm font-semibold">
        <img src="/icon/32.png" alt="" width="18" height="18" />
        Signalyze
      </span>
      <span class="rounded-full bg-brand-50 px-2 py-0.5 font-mono text-[11px] text-brand-700"
        >example data</span
      >
    </div>

    <div class="border-b border-line px-4 py-3">
      <p class="font-semibold">Harbour Street Bakery</p>
      <p class="mt-0.5 text-xs text-ink-600 tabular-nums">4.6 ★ · 1,240 reviews · 200 analysed</p>
    </div>

    <div class="grid grid-cols-[auto_1fr] items-center gap-4 border-b border-line px-4 py-4">
      <div class="ring h-20 w-20" style={`--p:${score}`}>
        <span class="text-2xl font-bold tabular-nums">{score}</span>
      </div>
      <div>
        <p class="text-xs text-ink-400">Signalyze Score · 0 to 100</p>
        <p class="mt-1 text-[11px] leading-snug text-ink-600">{SUMMARY_SENTENCE}</p>
      </div>
    </div>

    <section class="border-b border-line px-4 py-3">
      <h3 class="text-xs font-semibold text-ink-400">Signals</h3>
      <ul class="mt-2 space-y-1.5">
        {
          SIGNALS.map((s) => (
            <li class="grid grid-cols-[1fr_4.5rem_2.5rem] items-center gap-3 text-xs">
              <span class="truncate">{s.title}</span>
              <span class="meter" aria-hidden="true">
                <span style={`width:${Math.round(values[s.id] * 100)}%`} />
              </span>
              <span class="text-right font-mono text-ink-600 tabular-nums">
                {values[s.id].toFixed(2)}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-b border-line px-4 py-3">
      <h3 class="text-xs font-semibold text-ink-400">Reviews per month</h3>
      <div class="bars mt-2" aria-hidden="true">
        {
          months.map((m) => (
            <span
              class={m.n === maxMonth || m.n >= maxMonth * 0.75 ? 'hi' : ''}
              style={`height:${Math.round((m.n / maxMonth) * 100)}%`}
            />
          ))
        }
      </div>
      <div class="mt-1 flex justify-between font-mono text-[10px] text-ink-400" aria-hidden="true">
        {months.map((m) => <span class="flex-1 text-center">{m.label}</span>)}
      </div>
      <p class="mt-1 text-[11px] text-ink-600">
        40 of 80 reviews in the last year were posted within one 14-day window.
      </p>
    </section>

    <section class="border-b border-line px-4 py-3">
      <h3 class="text-xs font-semibold text-ink-400">Rating distribution</h3>
      <ul class="mt-2 space-y-1">
        {
          ratings.map((r) => (
            <li class="grid grid-cols-[1.5rem_1fr_2.5rem] items-center gap-2 text-xs">
              <span class="font-mono text-ink-600 tabular-nums">{r.stars}★</span>
              <span class="meter" aria-hidden="true">
                <span style={`width:${r.pct}%`} />
              </span>
              <span class="text-right font-mono text-ink-600 tabular-nums">{r.pct}%</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="px-4 py-3">
      <h3 class="text-xs font-semibold text-ink-400">Reviewers</h3>
      <dl class="mt-2 grid grid-cols-3 gap-2">
        {
          reviewers.map((r) => (
            <div class="rounded-lg bg-paper px-2 py-2">
              <dt class="text-[10px] leading-tight text-ink-600">{r.label}</dt>
              <dd class="mt-1 font-mono text-sm font-semibold tabular-nums">{r.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
  <figcaption class="mt-3 text-xs text-ink-400">
    Illustrative side panel. The place and every number are example data.
  </figcaption>
</figure>
