---
import { localePath, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale} title={t('meta.notFound.title')} description={t('meta.notFound.description')}>
  <main id="main" class="mx-auto max-w-3xl px-5 py-24 text-center sm:px-8 sm:py-32">
    <p class="eyebrow">{t('notFound.eyebrow')}</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{t('notFound.title')}</h1>
    <p class="mt-4 text-ink-600">{t('notFound.text')}</p>
    <a href={localePath(locale, '/')} class="btn-primary mt-8">{t('notFound.home')}</a>
  </main>
</Base>
