---
import '../styles/global.css';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_LABELS,
  LOCALE_NAMES,
  OG_LOCALES,
  localePath,
  logicalPath,
  useTranslations,
  type Locale,
} from '../i18n';
import { GITHUB_URL, SITE_NAME, STORE_URL } from '../lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** The home page uses a descriptive document title instead of "Home · Signalyze". */
  home?: boolean;
}

const { locale, title, description, home = false } = Astro.props;
const t = useTranslations(locale);
const pageTitle = home ? t('meta.home.title') : `${title} · ${SITE_NAME}`;

// With `build.format: 'file'` the build-time pathname is "/tr/privacy.html";
// the served URL is "/tr/privacy" (nginx try_files). `route` is the
// locale-independent page ("/privacy"), from which every locale's URL and the
// hreflang set are derived.
const route = logicalPath(Astro.url.pathname, locale);
const href = (target: Locale) => localePath(target, route);
const absolute = (target: Locale) => new URL(href(target), Astro.site).href;
const canonical = absolute(locale);
const ogImage = new URL('/icon/512.png', Astro.site).href;

const nav = [
  { route: '/methodology', label: t('nav.methodology') },
  { route: '/privacy', label: t('nav.privacy') },
  { route: '/changelog', label: t('nav.changelog') },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absolute(l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(DEFAULT_LOCALE)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon/180.png" />
    <meta name="theme-color" content="#2563eb" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
      ))
    }
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen bg-white text-ink-900">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:shadow"
      >{t('nav.skip')}</a
    >
    <header class="border-b border-line">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4 sm:px-8"
        aria-label={t('nav.main')}
      >
        <a
          href={localePath(locale, '/')}
          class="flex items-center gap-2 font-semibold tracking-tight"
        >
          <img src="/icon/32.png" alt="" width="24" height="24" />
          {SITE_NAME}
        </a>
        <ul class="flex items-center gap-4 text-sm text-ink-600 sm:gap-6">
          {
            nav.map((item) => (
              <li>
                <a
                  class="hover:text-ink-900 aria-[current=page]:text-ink-900 aria-[current=page]:font-medium"
                  href={localePath(locale, item.route)}
                  aria-current={route === item.route ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <ul class="flex items-center gap-2 font-mono text-xs" aria-label={t('nav.language')}>
              {
                LOCALES.map((l) => (
                  <li>
                    <a
                      class="rounded px-1.5 py-1 hover:text-ink-900 aria-[current=true]:bg-paper aria-[current=true]:font-semibold aria-[current=true]:text-ink-900"
                      href={href(l)}
                      hreflang={l}
                      lang={l}
                      title={LOCALE_NAMES[l]}
                      aria-current={l === locale ? 'true' : undefined}
                    >
                      {LOCALE_LABELS[l]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
          <li class="hidden sm:block">
            <a
              href={STORE_URL}
              class="rounded-md border border-line px-3 py-1.5 font-medium text-ink-900 hover:border-brand-500 hover:text-brand-600"
              >{t('nav.addToChrome')}</a
            >
          </li>
        </ul>
      </nav>
    </header>

    <slot />

    <footer class="mt-24 border-t border-line bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
        <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
          <div class="max-w-md">
            <a
              href={localePath(locale, '/')}
              class="flex items-center gap-2 font-semibold tracking-tight"
            >
              <img src="/icon/32.png" alt="" width="20" height="20" />
              {SITE_NAME}
            </a>
            <p class="mt-4 text-sm text-ink-600">{t('legal.summary')}</p>
            <p class="mt-2 text-sm text-ink-600">{t('legal.noClaim')}</p>
          </div>
          <ul class="grid grid-cols-2 gap-x-10 gap-y-3 text-sm sm:flex sm:gap-8">
            {
              nav.map((item) => (
                <li>
                  <a class="text-ink-700 hover:text-ink-900" href={localePath(locale, item.route)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="text-ink-700 hover:text-ink-900" href={GITHUB_URL} rel="noopener">
                {t('footer.github')}
              </a>
            </li>
            <li>
              <a class="text-ink-700 hover:text-ink-900" href={STORE_URL}>{t('nav.addToChrome')}</a>
            </li>
          </ul>
        </div>
        <p class="mt-10 max-w-3xl text-xs text-ink-400">{t('footer.trademark')}</p>
      </div>
    </footer>
  </body>
</html>
