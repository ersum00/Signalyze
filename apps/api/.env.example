# Copy to .env. Never commit .env.

# PostgreSQL connection (asyncpg DSN). Local dev: docker compose up -d db (root docker-compose.yml)
DATABASE_URL=postgresql://signalyze:signalyze@127.0.0.1:5433/signalyze

# Comma-separated Chrome extension ids allowed by CORS. Dev id comes from
# apps/extension/extension-key.json; the second id is the Web Store id.
EXTENSION_IDS=mecknkahfceojapfdeaelbapigaijcek,boalccknclijlfkpeaeohcpahidpchcf

# Port uvicorn binds to (127.0.0.1 only; the edge proxy terminates TLS).
PORT=8090

# Optional LLM endpoint (OpenAI-compatible). Leave BASE_URL/API_KEY empty to disable.
# The API only ever contacts the host of LLM_BASE_URL (runtime egress guard).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Used by the bare-metal deploy path (certbot). Not needed with the Caddy edge.
CERTBOT_EMAIL=
